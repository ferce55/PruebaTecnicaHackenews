{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "HackerNews": {
    "BaseUrl": "https://hacker-news.firebaseio.com/v0/",
    "MaxStories": 100,
    "BestStoriesCacheMinutes": 1,
    "StoryCacheMinutes": 5,
    "MaxConcurrentRequests": 8
  }
}
